# Copy to .env and fill in before: docker compose up -d --build
#
# Generate JWT secret:
#   cd apps/api && python -m app.cli gen-secret

DEBUG=false
JWT_SECRET=REPLACE_WITH_output_of_gen_secret
APP_ORIGINS=http://localhost:8080
PUBLIC_BASE_URL=http://localhost:8080

# Optional: auto-create admin on first boot only (prefer create-admin CLI instead)
# ADMIN_BOOTSTRAP_EMAIL=
# ADMIN_BOOTSTRAP_PASSWORD=

WEB_PORT=8080
